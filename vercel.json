{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "personal-blog-frontend-virid.vercel.app" }
      ],
      "destination": "https://otabek.dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "https://api.otabek.dev/feed.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.otabek.dev/sitemap.xml"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|WhatsApp|LinkedInBot|redditbot|Mastodon|Embedly|SkypeUriPreview|Pinterestbot|vkShare|Iframely|Bluesky).*"
        }
      ],
      "destination": "https://api.otabek.dev/share/blog/:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
